{
  "name": "obsidian-step-viewer",
  "version": "1.13.0",
  "description": "View STEP (.step/.stp), FreeCAD (.FCStd), OBJ and STL CAD models in a 3D viewer inside Obsidian.",
  "main": "main.js",
  "scripts": {
    "patch-occt": "node scripts/patch-occt-memory.mjs",
    "dev": "npm run patch-occt && node esbuild.config.mjs",
    "build": "npm run patch-occt && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "build:web": "npm run patch-occt && tsc -p tsconfig.web.json && node esbuild.web.mjs",
    "dev:web": "npm run patch-occt && node esbuild.web.mjs --serve",
    "icons": "node scripts/make-icons.mjs",
    "typecheck:web": "tsc -p tsconfig.web.json"
  },
  "keywords": [
    "obsidian",
    "step",
    "cad",
    "3d",
    "occt",
    "three"
  ],
  "author": "Ondřej Uhnávy",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/three": "^0.172.0",
    "esbuild": "^0.20.0",
    "lucide": "^1.46.0",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@mlightcad/cad-simple-ui-plugin": "^1.7.0",
    "@mlightcad/cad-simple-viewer": "^1.7.0",
    "@mlightcad/data-model": "^1.14.7",
    "@mlightcad/libredwg-converter": "^3.14.7",
    "fflate": "^0.8.3",
    "occt-import-js": "0.0.23",
    "three": "^0.172.0"
  },
  "allowScripts": {
    "esbuild@0.20.2": true
  }
}
